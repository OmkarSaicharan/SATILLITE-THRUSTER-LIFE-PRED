# AI PROVIDER CONFIGURATION
# The app will automatically use whichever key is provided.
# If both are provided, Groq is prioritized.

# GROQ_API_KEY: Required for Groq AI (Llama 3.3)
GROQ_API_KEY=

# GEMINI_API_KEY: Required for Gemini AI (Gemini 3.1)
GEMINI_API_KEY=

# OPENAI_API_KEY: Required for OpenAI API calls.
# Users must configure this via the Secrets panel in the AI Studio UI.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
